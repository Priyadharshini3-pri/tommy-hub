# --- Database ---
# Local Docker MySQL:
DATABASE_URL=mysql+pymysql://tommyhub_user:changeme@localhost:3306/tommy_hub
# Supabase Postgres also works (use its pooled connection URL):
# DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# --- Auth ---
JWT_SECRET_KEY=replace-with-a-long-random-secret

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- SMS provider: mock | fast2sms | twilio ---
SMS_PROVIDER=mock
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
